---
import type { Publication } from "../data/publications";
import PublicationVisual from "./PublicationVisual.astro";

interface Props {
  publication: Publication;
}

const { publication } = Astro.props;
const selfName = "Saku Peltonen";
---

<article class="publication-row">
  <div class="publication-thumb">
    {publication.rowImage || publication.image ? (
      <PublicationVisual publication={publication} context="row" />
    ) : (
      <div class="publication-thumb-label" aria-hidden="true">
        <span>{publication.venueShort}</span>
        <small>{publication.year}</small>
      </div>
    )}
  </div>

  <div class="publication-copy">
    <div class="publication-kicker">
      <span>{publication.venueShort}</span>
      {publication.note && <span>{publication.note}</span>}
    </div>
    <h3>{publication.title}</h3>
    <p class="publication-authors">
      {publication.authors.map((author, index) => (
        <>
          {index > 0 && ", "}
          {author === selfName ? <strong>{author}</strong> : author}
        </>
      ))}
    </p>
    <p class="publication-venue">
      {publication.venue}{publication.month ? `, ${publication.month}` : ""} {publication.year}
    </p>
    <div class="publication-links" role="group" aria-label={`Links for ${publication.title}`}>
      {publication.links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noreferrer"
          aria-label={`${link.label} — ${publication.title}`}
        >
          {link.label}<span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</article>
