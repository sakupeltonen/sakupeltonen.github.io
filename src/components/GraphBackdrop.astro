const edges = edgeSpecs.map(([from, to, tone = "loden", weight = "standard"]) => ({
  x1: nodes[from].x,
  y1: nodes[from].y,
  x2: nodes[to].x,
  y2: nodes[to].y,
  tone,
  weight,
}));
---

<svg
  class="graph-backdrop"
  viewBox="0 0 1600 1000"
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="graph-backdrop__edges">
    {edges.map((edge) => (
      <line
        x1={edge.x1}
        y1={edge.y1}
        x2={edge.x2}
        y2={edge.y2}
        class:list={[
          "graph-backdrop__edge",
          edge.tone === "slate" && "graph-backdrop__edge--slate",
          edge.weight === "quiet" && "graph-backdrop__edge--quiet",
          edge.weight === "strong" && "graph-backdrop__edge--strong",
        ]}
      />
    ))}
  </g>

  <g class="graph-backdrop__nodes">
    {nodes.map((node) => (
      <circle
        cx={node.x}
        cy={node.y}
        r={node.r}
        class:list={[
          "graph-backdrop__node",
          node.tone === "soft" && "graph-backdrop__node--soft",
          node.tone === "accent" && "graph-backdrop__node--accent",
        ]}
      />
    ))}
  </g>
</svg>
