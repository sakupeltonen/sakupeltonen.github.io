---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const links = [
  { href: "/", label: "Research" },
  { href: "/publications", label: "Publications" },
  { href: "/cv", label: "CV" },
];
---

<header class="site-header">
  <div class="shell nav-shell">
    <a class="wordmark" href="/" aria-label="Saku Peltonen, home">
      Saku Pe<span class="name-l">l</span>tonen
    </a>
    <nav aria-label="Primary navigation">
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>
