---
import type { Publication } from "../data/publications";
import PublicationVisual from "./PublicationVisual.astro";

interface Props {
  publication: Publication;
  priority?: boolean;
}

const { publication, priority = false } = Astro.props;
const selfName = "Saku Peltonen";
---

<article class="paper-card">
  <figure class="paper-visual">
    {publication.image ? (
      <PublicationVisual publication={publication} context="card" priority={priority} />
    ) : (
      <div class="paper-visual-fallback" aria-hidden="true">
        <span>{publication.venueShort}</span>
        <small>{publication.year}</small>
      </div>
    )}
  </figure>

  <div class="paper-content">
    <div class="paper-meta">
      <span>{publication.venueShort} {publication.year}</span>
      {publication.note && <span class="paper-note">{publication.note}</span>}
    </div>
    <h3>{publication.title}</h3>
    <p class="paper-authors">
      {publication.authors.map((author, index) => (
        <>
          {index > 0 && ", "}
          {author === selfName ? <strong>{author}</strong> : author}
        </>
      ))}
    </p>
    {publication.summary && (
      <p class="paper-summary">
        <span>In brief</span>
        {publication.summary}
      </p>
    )}
    <div class="paper-links" role="group" aria-label={`Links for ${publication.title}`}>
      {publication.links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noreferrer"
          aria-label={`${link.label} — ${publication.title}`}
        >
          {link.label}
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</article>
