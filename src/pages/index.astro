---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaperCard from "../components/PaperCard.astro";
import { selectedPublications } from "../data/publications";
---

<BaseLayout currentPath="/">
  <section class="shell intro-section" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="eyebrow">PhD student · ETH Zürich</p>
      <h1 id="intro-title">Saku Pe<span class="name-l">l</span>tonen</h1>
      <p class="intro-lead">
        I study graph learning for algorithmic and combinatorial reasoning, with
        current work on Boolean satisfiability, abstract reasoning, and graph
        generation.
      </p>
      <p class="intro-context">
        I am a PhD student in the{" "}
        <a href="https://disco.ethz.ch/" target="_blank" rel="noreferrer">Distributed Computing Group</a>{" "}
        at ETH Zürich.
      </p>
      <ul class="profile-links" aria-label="Profiles and contact">
        <li><a href="mailto:speltonen@ethz.ch">Email</a></li>
        <li><a href="https://github.com/sakupeltonen" target="_blank" rel="noreferrer">GitHub</a></li>
        <li><a href="https://ch.linkedin.com/in/sakupeltonen" target="_blank" rel="noreferrer">LinkedIn</a></li>
        <li><a href="https://disco.ethz.ch/members/speltonen" target="_blank" rel="noreferrer">ETH profile</a></li>
      </ul>
    </div>
    <figure class="portrait-frame">
      <div class="portrait-image">
        <img
          src="/images/profile.webp"
          alt="Portrait of Saku Peltonen"
          width="720"
          height="739"
          decoding="async"
        />
      </div>
    </figure>
  </section>

  <section class="shell papers-section" aria-labelledby="selected-papers-title">
    <div class="section-heading-row">
      <div>
        <p class="eyebrow">Research</p>
        <h2 id="selected-papers-title">Selected papers</h2>
      </div>
      <a class="section-link" href="/publications">All publications <span aria-hidden="true">→</span></a>
    </div>
    <div class="paper-list">
      {selectedPublications.map((publication, index) => (
        <PaperCard publication={publication} priority={index === 0} />
      ))}
    </div>
  </section>
</BaseLayout>
