---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GraphBackdrop from "../components/GraphBackdrop.astro";
import "../styles/palette.generated.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title = "Saku Peltonen — Research",
  description = "Research and publications of Saku Peltonen, a PhD student at ETH Zürich working on graph learning and combinatorial reasoning.",
  currentPath = "/",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:opsz,wght@8..60,400;8..60,500;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <GraphBackdrop />
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
